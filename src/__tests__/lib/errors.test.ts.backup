/**
 * Unit tests for lib/errors.ts
 * Sprint 051 — Test Debt
 */
import { describe, it, expect } from "vitest";
import { isAppError, getUserErrorMessage, AppError } from "@/lib/errors";

describe("isAppError", () => {
  it("returns true for AppError instances", () => {
    const error = new AppError("Test", "TEST_ERROR", 500, "User msg");
    expect(isAppError(error)).toBe(true);
  });

  it("returns false for regular Error", () => {
    expect(isAppError(new Error("test"))).toBe(false);
  });

  it("returns false for null", () => {
    expect(isAppError(null)).toBe(false);
  });

  it("returns false for undefined", () => {
    expect(isAppError(undefined)).toBe(false);
  });

  it("returns false for string", () => {
    expect(isAppError("error")).toBe(false);
  });

  it("returns false for plain object (not instanceof)", () => {
    const error = { code: "TEST_ERROR", message: "Test", userMessage: "User msg" };
    expect(isAppError(error)).toBe(false);
  });
});

describe("getUserErrorMessage", () => {
  it("returns userMessage from AppError", () => {
    const error = new AppError("internal", "TEST", 500, "User friendly");
    expect(getUserErrorMessage(error)).toBe("User friendly");
  });

  it("returns generic Russian message for regular Error", () => {
    expect(getUserErrorMessage(new Error("test error"))).toBe("Произошла ошибка. Попробуйте позже.");
  });

  it("returns generic Russian message for unknown errors", () => {
    expect(getUserErrorMessage(null)).toBe("Неизвестная ошибка. Попробуйте позже.");
    expect(getUserErrorMessage(undefined)).toBe("Неизвестная ошибка. Попробуйте позже.");
  });

  it("returns generic Russian message for string errors", () => {
    expect(getUserErrorMessage("something went wrong")).toBe("Неизвестная ошибка. Попробуйте позже.");
  });

  it("returns network error message for network errors", () => {
    expect(getUserErrorMessage(new Error("network error"))).toBe("Проблема с подключением. Проверьте интернет.");
  });

  it("returns timeout message for timeout errors", () => {
    expect(getUserErrorMessage(new Error("request timeout")).toBe("Timeout exceeded. Try again.");
  });

  it("returns auth message for unauthorized errors", () => {
    expect(getUserErrorMessage(new Error("unauthorized")).toBe("Authorization required. Please log in again.");
  });

  it("returns not found message for 404 errors", () => {
    expect(getUserErrorMessage(new Error("not found")).toBe("Requested resource not found.");
  });
});
