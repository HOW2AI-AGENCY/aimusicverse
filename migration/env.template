# ============================================================================
# MusicVerse AI — шаблон переменных окружения новой инфраструктуры
# ============================================================================
# Заполните значения после развёртывания целевой платформы.
# Разделите на .env.frontend (Vite) и .env.functions (Edge) при деплое.

# ─── Frontend (Vite build-time) ────────────────────────────────────────────
# Автогенерируется Supabase/Lovable Cloud при подключении бэкенда; править
# вручную только при переходе на другой Supabase-проект.
VITE_SUPABASE_URL="https://YOUR-NEW-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi..."
VITE_SUPABASE_PROJECT_ID="YOUR-NEW-PROJECT-REF"

# ─── Auto (провайдится Supabase runtime, не задавать вручную на Supabase) ──
# На Deno Deploy / Cloudflare Workers — задать явно.
SUPABASE_URL="https://YOUR-NEW-PROJECT-REF.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."   # СЕКРЕТ! только на бэкенде

# ─── Suno AI ───────────────────────────────────────────────────────────────
SUNO_API_KEY=""
SUNO_WEBHOOK_SECRET=""

# ─── Lovable AI Gateway (chat completions, TTS, embeddings) ────────────────
# Если уходим с Lovable — заменить в коде на OPENAI_API_KEY / ANTHROPIC_API_KEY
LOVABLE_API_KEY=""

# ─── Telegram Bot + Mini App ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""                 # от @BotFather
TELEGRAM_BOT_USERNAME=""              # без @
TELEGRAM_APP_SHORT_NAME=""            # короткое имя Mini App
TELEGRAM_BOT_MINIAPP_URL=""           # https://your-domain или https://t.me/BOT/app
TELEGRAM_WEBHOOK_SECRET=""            # рандомная строка, ей же передавать в setWebhook
TELEGRAM_WEBHOOK_SECRET_TOKEN=""      # альтернативное имя того же (legacy)
TELEGRAM_CHANNEL_USERNAME=""          # канал новостей, без @
TELEGRAM_NEWS_CHANNEL=""              # резервное имя канала
TELEGRAM_SUPPORT_USERNAME=""          # юзернейм поддержки, без @
MINI_APP_URL=""                       # публичный URL Mini App

# ─── Tinkoff Payments ──────────────────────────────────────────────────────
TINKOFF_TERMINAL_KEY=""
TINKOFF_SECRET_KEY=""

# ─── Внешние AI/аналитика ──────────────────────────────────────────────────
KLANGIO_API_KEY=""                    # MIDI transcription
REPLICATE_API_KEY=""                  # Replicate models (upscale, watermark)
FAL_API_KEY=""                        # Fal.ai (image generation)
AUDD_API_KEY=""                       # Music recognition

# ─── Обслуживание ──────────────────────────────────────────────────────────
CRON_SECRET=""                        # header X-Cron-Secret для scheduled endpoints
ENVIRONMENT="production"              # production | staging
