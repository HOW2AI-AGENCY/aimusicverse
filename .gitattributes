# Git Attributes — https://git-scm.com/docs/gitattributes
# Ensures consistent line endings and correct diff rendering across platforms.

# Default: detect text files automatically, normalize to LF on commit
* text=auto

# --- Source Code ---
# Explicitly treat as text with LF normalization
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf

# --- Styles & Config ---
*.css   text eol=lf
*.scss  text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.jsonc text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.env   text eol=lf

# --- Docs ---
*.md    text eol=lf

# --- Shell scripts (must always be LF) ---
*.sh    text eol=lf
*.bash  text eol=lf

# --- SQL ---
*.sql   text eol=lf

# --- Binary files (do not normalize) ---
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.svg   text eol=lf
*.ico   binary
*.webp  binary
*.mp3   binary
*.mp4   binary
*.webm  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary

# --- Lockfiles (show as binary to avoid merge conflicts) ---
bun.lock       -diff
bun.lockb      binary
package-lock.json -diff

# --- Diff heuristics: use TypeScript/JS-specific diff driver ---
*.ts    diff=typescript
*.tsx   diff=typescript
*.js    diff=javascript
*.jsx   diff=javascript
