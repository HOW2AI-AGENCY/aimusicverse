# EditorConfig — https://editorconfig.org
# Ensures consistent coding style across different editors and IDEs.

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# JavaScript, TypeScript, React
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_style = space
indent_size = 2

# JSON, JSONC
[*.{json,jsonc}]
indent_style = space
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# CSS, SCSS
[*.{css,scss,sass}]
indent_style = space
indent_size = 2

# HTML
[*.html]
indent_style = space
indent_size = 2

# Markdown — preserve trailing whitespace (it has semantic meaning in MD)
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
insert_final_newline = true

# Shell scripts
[*.sh]
end_of_line = lf
indent_size = 2

# SQL migrations
[*.sql]
indent_style = space
indent_size = 2

# Config files
[*.{toml,ini,cfg}]
indent_style = space
indent_size = 2

# Makefiles require tabs
[Makefile]
indent_style = tab
