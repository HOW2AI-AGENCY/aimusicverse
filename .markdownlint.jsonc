{
  // Repository documentation style guide — see docs/STYLE_GUIDE.md
  "default": true,
  "MD013": false,              // line length: prose-friendly
  "MD024": { "siblings_only": true }, // duplicate headings allowed across sections
  "MD033": false,              // inline HTML allowed (badges, mermaid)
  "MD041": false,              // first line need not be H1 (badges block first)
  "MD036": false,
  "MD040": false,              // allow fenced code without language for diagrams
  "MD046": { "style": "fenced" },
  "MD007": { "indent": 2 },
  "MD025": { "front_matter_title": "" }
}
