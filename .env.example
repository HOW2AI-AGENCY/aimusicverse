# ============================================================
# MusicVerse AI — Environment Configuration
# ============================================================
# Two separate sets of variables (do NOT mix them):
#
#   1) FRONTEND (this .env)  — VITE_* only, bundled into the client, PUBLIC values.
#   2) BACKEND  (Supabase)   — Edge Function secrets, server-side only, NEVER here in prod.
#
# Copy this file to .env and fill in your values.
# Full reference: docs/ENVIRONMENT_VARIABLES.md
# Handoff / ownership transfer: HANDOFF.md (§4 secrets register)
# ============================================================


# ============================================================
#  1) FRONTEND  —  .env  (VITE_ prefix, public, build-time)
# ============================================================

# ---- Supabase / Lovable Cloud (REQUIRED) -------------------
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
VITE_SUPABASE_PROJECT_ID=your_project_reference_id

# ---- Sentry Error Tracking (OPTIONAL, recommended) ---------
VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ---- Application (OPTIONAL) ---------------------------------
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development
VITE_TELEGRAM_BOT_USERNAME=AIMusicVerseBot
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# ---- Feature Flags (OPTIONAL) ------------------------------
VITE_FEATURE_MIDI_TRANSCRIPTION=false
VITE_FEATURE_ADVANCED_MASTERING=false
VITE_FEATURE_AI_MIXING=false
VITE_FEATURE_CLOUD_COLLABORATION=false
VITE_FEATURE_MOBILE_RECORDING=false

# ---- Performance (OPTIONAL) --------------------------------
VITE_CACHE_AUDIO=true
VITE_LAZY_LOAD_IMAGES=true
VITE_PREFETCH_ROUTES=true
VITE_REDUCED_MOTION=true

# ---- Testing (OPTIONAL) ------------------------------------
VITE_TEST_MODE=false
VITE_DEMO_MODE=false
VITE_DEBUG_TOOLS=false


# ============================================================
#  2) BACKEND  —  Supabase Edge Function secrets
#  Set these in: Supabase → Settings → Edge Functions → Secrets
#  (listed here only as a reference — never commit real values)
# ============================================================
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
# are injected automatically by the platform.

# ---- Suno AI (REQUIRED — core music generation) ------------
SUNO_API_KEY=sk-xxxxx
SUNO_WEBHOOK_SECRET=your-suno-webhook-secret

# ---- AI & MIDI ---------------------------------------------
LOVABLE_API_KEY=your-lovable-ai-gateway-key
KLANGIO_API_KEY=your-klangio-key

# ---- Telegram ----------------------------------------------
TELEGRAM_BOT_TOKEN=1234567890:ABCdef...
TELEGRAM_BOT_USERNAME=AIMusicVerseBot
TELEGRAM_APP_SHORT_NAME=app
TELEGRAM_BOT_MINIAPP_URL=https://your-app-url
MINI_APP_URL=https://your-app-url
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
TELEGRAM_WEBHOOK_SECRET_TOKEN=your-webhook-header-token
TELEGRAM_CHANNEL_USERNAME=your_channel
TELEGRAM_NEWS_CHANNEL=your_news_channel
TELEGRAM_SUPPORT_USERNAME=your_support

# ---- Payments (OPTIONAL — Tinkoff acquiring, RU cards) -----
# Telegram Stars needs no key (configured via BotFather).
TINKOFF_TERMINAL_KEY=your-terminal-key
TINKOFF_SECRET_KEY=your-secret-key

# ---- Media services (OPTIONAL) -----------------------------
FAL_API_KEY=your-fal-key
REPLICATE_API_KEY=your-replicate-key
AUDD_API_KEY=your-audd-key

# ---- Ops ---------------------------------------------------
CRON_SECRET=your-cron-secret
ENVIRONMENT=production
