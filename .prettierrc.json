{
  "semi": true,
  "trailingComma": "all",
  "singleQuote": false,
  "printWidth": 120,
  "tabWidth": 2,
  "markdown": {
    "printWidth": 120,
    "proseWrap": "preserve",
    "enableExperimentalTrickyMarkdown": true
  },
  "overrides": [
    {
      "files": "*.md",
      "options": {
        "printWidth": 120,
        "proseWrap": "preserve"
      }
    },
    {
      "files": "*.json",
      "options": {
        "printWidth": 120
      }
    },
    {
      "files": "*.{ts,tsx}",
      "options": {
        "printWidth": 120,
        "trailingComma": "all"
      }
    }
  ]
}