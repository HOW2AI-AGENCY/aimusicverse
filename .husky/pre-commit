#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔧 Running pre-commit checks..."
echo ""

# Run lint-staged for staged files
npx lint-staged

# Run typecheck
echo ""
echo "📝 Running TypeScript type check..."
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "❌ TypeScript type check failed!"
  exit 1
fi

echo ""
echo "✅ All pre-commit checks passed!"