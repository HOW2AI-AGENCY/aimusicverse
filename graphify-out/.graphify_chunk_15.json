      "title": "Track Versioning System",
      "description": "Git-like version management for music tracks with A/B versions, primary version switching, change logging, and optimistic updates for user experience.",
      "architecture": "Track → TrackVersions (A/B/C)",
      "database_fields": {
        "is_primary": "boolean - Main version flag (CORRECT)",
        "version_label": "string - User label (A, B, C)",
        "version_type": "string - Type (initial, extended, remix)",
        "clip_index": "number - 0 or 1"
      },
      "constraints": [
        "Only one primary version per track",
        "Unique index on is_primary",
        "Changelog mandatory for changes"
      ],
      "utilities": [
