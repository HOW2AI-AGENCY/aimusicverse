From e9abf9972420a0cdba14809aeffc7c1f1c063ca4 Mon Sep 17 00:00:00 2001
From: HOW2AI <ivan.meer1990@gmail.com>
Date: Sun, 5 Jul 2026 18:19:39 +0700
Subject: [PATCH 22/28] fix(ci): resolve storybook 8.x eslint peer dependency
 conflicts

- add --legacy-peer-deps to all npm ci commands in ci workflows
- fix ci failure caused by @typescript-eslint/utils@5.62.0 requiring eslint 8
- storybook 8.x dependencies expect eslint 8, but project uses eslint 9
- updated workflows: ci.yml, e2e.yml, quality-check.yml
- unblocks ci pipeline that was failing at 'install dependencies' step

co-authored-by: claude <noreply@anthropic.com>
---
 .github/workflows/ci.yml            |  10 +++++-----
 .github/workflows/e2e.yml           |   2 +-
 .github/workflows/quality-check.yml |   4 ++--
 package-lock.json                   | Bin 657575 -> 658280 bytes
 4 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index b6dc82a2..c708b1d9 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -26,7 +26,7 @@ jobs:
           cache: "npm"
 
       - name: Install dependencies
-        run: npm ci
+        run: npm ci --legacy-peer-deps
 
       - name: Lint check
         run: npm run lint
@@ -68,7 +68,7 @@ jobs:
           cache: "npm"
 
       - name: Install dependencies
-        run: npm ci
+        run: npm ci --legacy-peer-deps
 
       - name: Pre-build type check
         run: npm run typecheck:app
@@ -127,7 +127,7 @@ jobs:
           cache: "npm"
 
       - name: Install dependencies
-        run: npm ci
+        run: npm ci --legacy-peer-deps
 
       - name: Install Playwright browsers
         run: npx playwright install --with-deps chromium
@@ -178,7 +178,7 @@ jobs:
           cache: "npm"
 
       - name: Install dependencies
-        run: npm ci
+        run: npm ci --legacy-peer-deps
 
       - name: Install Playwright browsers (chromium + webkit)
         run: npx playwright install --with-deps chromium webkit
@@ -237,7 +237,7 @@ jobs:
           cache: "npm"
 
       - name: Install dependencies
-        run: npm ci
+        run: npm ci --legacy-peer-deps
 
       - name: Install Playwright browser (${{ matrix.browser }})
         run: npx playwright install --with-deps ${{ matrix.browser }}
diff --git a/.github/workflows/e2e.yml b/.github/workflows/e2e.yml
index 4a5d9fad..1f0b3018 100644
--- a/.github/workflows/e2e.yml
+++ b/.github/workflows/e2e.yml
@@ -36,7 +36,7 @@ jobs:
           cache: "npm"
 
       - name: Install dependencies
-        run: npm ci
+        run: npm ci --legacy-peer-deps
 
       - name: Install Playwright browsers
         run: npx playwright install --with-deps chromium
diff --git a/.github/workflows/quality-check.yml b/.github/workflows/quality-check.yml
index 3c28caf3..c0163c96 100644
--- a/.github/workflows/quality-check.yml
+++ b/.github/workflows/quality-check.yml
@@ -26,7 +26,7 @@ jobs:
           cache: "npm"
 
       - name: Install dependencies
-        run: npm ci
+        run: npm ci --legacy-peer-deps
 
       - name: Lint
         run: npm run lint
@@ -55,7 +55,7 @@ jobs:
           cache: "npm"
 
       - name: Install dependencies
-        run: npm ci
+        run: npm ci --legacy-peer-deps
 
       - name: Pre-build type check
         run: npm run typecheck:app
diff --git a/package-lock.json b/package-lock.json
index a5ac808928d48763b89ee7202186a0b1586b3e15..4d14e9e40dd2bd2b31639d0350ff97a22789cda0 100644
