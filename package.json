{
  "name": "aimusicverse",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:css-imports": "node scripts/check-css-imports.mjs",
    "check:section-tokens": "node scripts/check-section-tokens.mjs",
    "check:design-tokens": "npm run check:css-imports && npm run check:section-tokens",
    "prebuild": "npm run typecheck",
    "build": "vite build",
    "clean:cache": "node scripts/clean-cache.mjs",
    "reset": "node scripts/clean-cache.mjs && npm install && npm run build",
    "test": "cross-env NODE_OPTIONS=--max-old-space-size=2048 vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test tests/e2e/smoke.app-boots.spec.ts --project=chromium --project=firefox --project=webkit --reporter=list,html,json",
    "test:smoke:matrix": "playwright test tests/e2e/smoke.app-boots.spec.ts --project=chromium --project=firefox --project=webkit --workers=3 --reporter=list,html,json",
    "test:smoke:chromium": "playwright test tests/e2e/smoke.app-boots.spec.ts --project=chromium --reporter=list,html,json",
    "test:smoke:report": "playwright show-report",
    "e2e:smoke": "bash scripts/e2e.sh",
    "e2e:smoke:rerun": "bash scripts/e2e.sh --rerun-failed",
    "test:visual": "playwright test tests/e2e/visual.section.spec.ts --project=chromium --reporter=list,html",
    "test:visual:update": "playwright test tests/e2e/visual.section.spec.ts --project=chromium --update-snapshots",
    "e2e:wait-server": "node scripts/wait-for-dev-server.mjs",
    "test:e2e:hints:wait": "npm run e2e:wait-server && npm run test:e2e:hints",
    "test:e2e:hints:update": "npm run e2e:wait-server && npx playwright test tests/e2e/hints*.spec.ts --update-snapshots --reporter=list",
    "test:e2e:hints": "npx playwright test tests/e2e/hints*.spec.ts --retries=2 --trace=on-all-retries --screenshot=only-on-failure --video=retain-on-failure",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:filenames": "node scripts/lint-filenames.js",
    "migrate:filenames": "node scripts/migrate-filenames.js",
    "migrate:filenames:dry": "node scripts/migrate-filenames.js --dry-run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "lighthouse": "npx lhci autorun",
    "lighthouse:collect": "npx lhci collect",
    "lighthouse:assert": "npx lhci assert",
    "analyze": "npm run build && echo \"📦 Bundle analysis ready. Open dist/stats.html in your browser.\"",
    "size:track": "node scripts/track-bundle-size.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky",
    "typecheck": "tsc --build --force",
    "typecheck:app": "tsc --noEmit --project tsconfig.app.json",
    "typecheck:strict": "tsc --noEmit --project tsconfig.app.json --strict",
    "typecheck:any-count": "node scripts/count-any.mjs",
    "check-all": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "clean": "rm -rf dist coverage storybook-static node_modules",
    "ci:build": "npm run lint && npm run build && npm run test:coverage",
    "test:security": "npm audit --audit-level=high",
    "test:security:fix": "npm audit fix",
    "test:sast": "echo 'SAST scanning with GitHub Advanced Security or Snyk'",
    "security:scan": "npm run test:security && npm run test:sast",
    "security:check": "npm audit && echo '✅ Security check complete'",
    "seo:check": "node scripts/seo-check.mjs",
    "seo:postbuild": "node scripts/seo-check.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@hookform/resolvers": "^5.2.2",
    "@lovable.dev/cloud-auth-js": "^1.1.2",
    "@lovable.dev/mcp-js": "^0.20.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/react": "^10.31.0",
    "@supabase/supabase-js": "^2.86.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@tanstack/react-query": "^5.90.11",
    "@tonejs/midi": "^2.0.28",
    "@twa-dev/sdk": "^8.0.2",
    "@use-gesture/react": "^10.3.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.19",
    "dompurify": "^3.3.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.24",
    "i18next": "^26.3.5",
    "i18next-browser-languagedetector": "^8.2.1",
    "jszip": "^3.10.1",
    "lamejs": "^1.2.1",
    "lovable-tagger": "^1.1.11",
    "lucide-react": "^0.555.0",
    "opensheetmusicdisplay": "^1.9.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-day-picker": "^9.11.3",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.67.0",
    "react-i18next": "^17.0.8",
    "react-resizable-panels": "^3.0.6",
    "react-router-dom": "^7.9.6",
    "react-swipeable": "^7.0.2",
    "react-virtuoso": "^4.17.0",
    "recharts": "^3.5.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tone": "^14.9.17",
    "use-debounce": "^10.0.6",
    "vaul": "^1.1.2",
    "wavesurfer.js": "^7.8.8",
    "web-audio-beat-detector": "^8.2.32",
    "web-vitals": "^4.2.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@chromatic-com/storybook": "^1.5.0",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.1",
    "@size-limit/file": "^12.0.0",
    "@storybook/addon-a11y": "^8.1.0",
    "@storybook/addon-docs": "^8.1.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.1.0",
    "@storybook/addon-links": "^8.1.0",
    "@storybook/addon-onboarding": "^8.1.0",
    "@storybook/blocks": "^8.1.0",
    "@storybook/react": "^8.1.0",
    "@storybook/react-vite": "^8.1.0",
    "@storybook/test": "^8.1.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/dompurify": "^3.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/browser-playwright": "^4.0.14",
    "@vitest/coverage-v8": "^4.0.14",
    "autoprefixer": "^10.4.22",
    "axe-core": "^4.11.0",
    "chromatic": "^18.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^0.8.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.5.3",
    "globals": "^17.7.0",
    "husky": "^9.0.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.0.0",
    "madge": "^8.0.0",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.4",
    "rollup-plugin-visualizer": "^6.0.5",
    "storybook": "^8.1.0",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.44.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.1.4",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.0.14"
  },
  "size-limit": [
    {
      "name": "Total Bundle",
      "path": "dist/assets/*.js",
      "limit": "2.3 MB",
      "gzip": true
    },
    {
      "name": "React Vendor",
      "path": "dist/assets/vendor-react*.js",
      "limit": "200 KB",
      "gzip": true
    },
    {
      "name": "Framer Motion Vendor",
      "path": "dist/assets/vendor-framer*.js",
      "limit": "100 KB",
      "gzip": true
    },
    {
      "name": "Tone.js Vendor",
      "path": "dist/assets/vendor-tone*.js",
      "limit": "150 KB",
      "gzip": true
    },
    {
      "name": "Wavesurfer Vendor",
      "path": "dist/assets/vendor-wavesurfer*.js",
      "limit": "100 KB",
      "gzip": true
    },
    {
      "name": "TanStack Query Vendor",
      "path": "dist/assets/vendor-query*.js",
      "limit": "50 KB",
      "gzip": true
    },
    {
      "name": "Radix UI Vendor",
      "path": "dist/assets/vendor-radix*.js",
      "limit": "80 KB",
      "gzip": true
    },
    {
      "name": "Studio Feature",
      "path": "dist/assets/feature-studio*.js",
      "limit": "750 KB",
      "gzip": true
    },
    {
      "name": "OSMD Vendor",
      "path": "dist/assets/vendor-osmd*.js",
      "limit": "320 KB",
      "gzip": true
    }
  ],
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.1.4",
    "@rollup/rollup-win32-x64-msvc": "^4.62.2"
  }
}
